diff --git a/src/pages/admin.astro b/src/pages/admin.astro
new file mode 100644
index 0000000..5992491
--- /dev/null
+++ b/src/pages/admin.astro
@@ -0,0 +1,235 @@
+---
+// src/pages/admin.astro
+// Panel privado (no está en el menú de navegación, solo accesible por URL directa).
+import Layout from '../layouts/Layout.astro';
+import { GOOGLE_SCRIPT_URL } from '../constants.ts';
+---
+
+<Layout title="Panel de Cotizaciones" description="Panel privado de gestión de cotizaciones.">
+  <section class="py-12 md:py-16 bg-[#F7FAFD] min-h-[70vh]">
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
+
+      <div id="auth-gate" class="max-w-sm mx-auto bg-white border border-[#91DAEE]/30 rounded-2xl p-8 shadow-sm text-center">
+        <h1 class="text-[#00456F] font-black text-xl mb-2">🔒 Panel Privado</h1>
+        <p class="text-slate-500 text-sm mb-6">Ingresa la clave para ver la cartera de clientes.</p>
+        <input
+          type="password"
+          id="secret-input"
+          placeholder="Clave de acceso"
+          class="w-full bg-[#F7FAFD] border border-slate-300 rounded-xl px-4 py-3 text-sm text-center outline-none focus:border-[#009EE0] focus:ring-2 focus:ring-[#009EE0]/20 mb-3"
+        />
+        <button id="auth-btn" class="w-full bg-[#009EE0] hover:bg-[#1CB1E1] text-white font-bold py-3 rounded-xl text-sm uppercase tracking-wider transition-all active:scale-95">
+          Entrar
+        </button>
+        <p id="auth-error" class="text-red-600 text-xs mt-3 hidden">Clave incorrecta o error de conexión.</p>
+      </div>
+
+      <div id="dashboard" class="hidden">
+
+        <div class="flex items-center justify-between mb-8">
+          <h1 class="text-[#00456F] font-black text-2xl md:text-3xl tracking-tight">Cartera de Clientes</h1>
+          <button id="refresh-btn" class="text-xs font-bold uppercase tracking-wider text-[#009EE0] hover:text-[#1CB1E1] border border-[#91DAEE]/40 px-4 py-2 rounded-xl transition-all">
+            ↻ Actualizar
+          </button>
+        </div>
+
+        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
+          <div class="bg-white border border-[#91DAEE]/30 rounded-2xl p-5">
+            <p class="text-3xl font-black text-[#00456F]" id="metric-total">–</p>
+            <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-1">Cotizaciones totales</p>
+          </div>
+          <div class="bg-white border border-[#91DAEE]/30 rounded-2xl p-5">
+            <p class="text-3xl font-black text-[#00456F]" id="metric-mes">–</p>
+            <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-1">Este mes</p>
+          </div>
+          <div class="bg-white border border-[#91DAEE]/30 rounded-2xl p-5">
+            <p class="text-3xl font-black text-emerald-600" id="metric-vendidos">–</p>
+            <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-1">Vendidas (tasa <span id="metric-tasa">–</span>)</p>
+          </div>
+          <div class="bg-white border border-[#91DAEE]/30 rounded-2xl p-5">
+            <p class="text-3xl font-black text-[#009EE0]" id="metric-ingresos">–</p>
+            <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mt-1">Ingresos registrados</p>
+          </div>
+        </div>
+
+        <div class="bg-white border border-[#91DAEE]/30 rounded-2xl overflow-hidden">
+          <table class="w-full text-sm">
+            <thead class="bg-[#00456F] text-white text-left">
+              <tr>
+                <th class="p-4 font-bold">Fecha</th>
+                <th class="p-4 font-bold">Cliente</th>
+                <th class="p-4 font-bold">Producto interés</th>
+                <th class="p-4 font-bold">Estado</th>
+                <th class="p-4 font-bold">Acciones</th>
+              </tr>
+            </thead>
+            <tbody id="leads-tbody">
+              <tr><td colspan="5" class="p-6 text-center text-slate-400">Cargando...</td></tr>
+            </tbody>
+          </table>
+        </div>
+
+      </div>
+    </div>
+  </section>
+
+  <script is:inline define:vars={{ GOOGLE_SCRIPT_URL }}>
+    document.addEventListener('DOMContentLoaded', () => {
+      const authGate = document.getElementById('auth-gate');
+      const dashboard = document.getElementById('dashboard');
+      const secretInput = document.getElementById('secret-input');
+      const authBtn = document.getElementById('auth-btn');
+      const authError = document.getElementById('auth-error');
+      const refreshBtn = document.getElementById('refresh-btn');
+      const tbody = document.getElementById('leads-tbody');
+
+      const badgeClasses = {
+        Nuevo: 'bg-blue-100 text-blue-700',
+        Cotizado: 'bg-amber-100 text-amber-700',
+        Vendido: 'bg-emerald-100 text-emerald-700',
+        Perdido: 'bg-slate-200 text-slate-500',
+      };
+
+      function getToken() {
+        return sessionStorage.getItem('vg_admin_token') || '';
+      }
+
+      async function loadLeads() {
+        const token = getToken();
+        if (!GOOGLE_SCRIPT_URL || !GOOGLE_SCRIPT_URL.startsWith('http')) {
+          tbody.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-red-500">Falta configurar GOOGLE_SCRIPT_URL en constants.ts</td></tr>';
+          return;
+        }
+        try {
+          const res = await fetch(`${GOOGLE_SCRIPT_URL}?token=${encodeURIComponent(token)}`);
+          const data = await res.json();
+
+          if (!data.success) {
+            authError.classList.remove('hidden');
+            authGate.classList.remove('hidden');
+            dashboard.classList.add('hidden');
+            sessionStorage.removeItem('vg_admin_token');
+            return;
+          }
+
+          authGate.classList.add('hidden');
+          dashboard.classList.remove('hidden');
+          renderLeads(data.leads || []);
+        } catch (err) {
+          authError.textContent = 'Error de conexión con la base de datos.';
+          authError.classList.remove('hidden');
+        }
+      }
+
+      function renderLeads(leads) {
+        const now = new Date();
+        const thisMonth = leads.filter((l) => {
+          const d = new Date(l.Fecha);
+          return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
+        });
+        const vendidos = leads.filter((l) => l.Estado === 'Vendido');
+        const ingresos = vendidos.reduce((sum, l) => sum + (parseFloat(l.MontoVenta) || 0), 0);
+        const tasa = leads.length ? Math.round((vendidos.length / leads.length) * 100) : 0;
+
+        document.getElementById('metric-total').textContent = leads.length;
+        document.getElementById('metric-mes').textContent = thisMonth.length;
+        document.getElementById('metric-vendidos').textContent = vendidos.length;
+        document.getElementById('metric-tasa').textContent = `${tasa}%`;
+        document.getElementById('metric-ingresos').textContent = `$${ingresos.toLocaleString('es-CL')}`;
+
+        if (!leads.length) {
+          tbody.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-slate-400">Aún no hay cotizaciones registradas.</td></tr>';
+          return;
+        }
+
+        tbody.innerHTML = leads
+          .map((lead, idx) => {
+            const fecha = lead.Fecha ? new Date(lead.Fecha).toLocaleDateString('es-CL') : '-';
+            const estado = lead.Estado || 'Nuevo';
+            const badge = badgeClasses[estado] || badgeClasses.Nuevo;
+            return `
+              <tr class="border-t border-slate-100 align-top">
+                <td class="p-4 text-slate-500 whitespace-nowrap">${fecha}</td>
+                <td class="p-4">
+                  <p class="font-bold text-[#00456F]">${lead.Nombre || '-'}</p>
+                  <p class="text-xs text-slate-500">${lead.Empresa || ''} ${lead.Telefono ? '· ' + lead.Telefono : ''}</p>
+                </td>
+                <td class="p-4 text-slate-600">${lead.ProductoInteres || '-'}</td>
+                <td class="p-4">
+                  <span class="text-xs font-bold px-3 py-1 rounded-full ${badge}">${estado}</span>
+                </td>
+                <td class="p-4">
+                  <div class="flex flex-col gap-2 min-w-[200px]" id="actions-${idx}">
+                    <div class="flex gap-2">
+                      <button data-idx="${idx}" class="btn-vendido text-[10px] font-bold uppercase bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-2 rounded-lg transition-all">Marcar vendida</button>
+                      <button data-idx="${idx}" data-id="${lead.ID}" class="btn-perdido text-[10px] font-bold uppercase bg-slate-200 hover:bg-slate-300 text-slate-600 px-3 py-2 rounded-lg transition-all">Perdida</button>
+                    </div>
+                    <div class="hidden flex-col gap-1.5" id="venta-form-${idx}">
+                      <input type="text" placeholder="Producto vendido" id="producto-${idx}" class="text-xs border border-slate-300 rounded-lg px-2 py-1.5" />
+                      <input type="number" placeholder="Monto ($)" id="monto-${idx}" class="text-xs border border-slate-300 rounded-lg px-2 py-1.5" />
+                      <button data-idx="${idx}" data-id="${lead.ID}" class="btn-confirmar-venta text-[10px] font-bold uppercase bg-[#009EE0] hover:bg-[#1CB1E1] text-white px-3 py-1.5 rounded-lg transition-all">Confirmar venta</button>
+                    </div>
+                  </div>
+                </td>
+              </tr>
+            `;
+          })
+          .join('');
+
+        document.querySelectorAll('.btn-vendido').forEach((btn) => {
+          btn.addEventListener('click', () => {
+            document.getElementById(`venta-form-${btn.dataset.idx}`).classList.remove('hidden');
+            document.getElementById(`venta-form-${btn.dataset.idx}`).classList.add('flex');
+          });
+        });
+
+        document.querySelectorAll('.btn-perdido').forEach((btn) => {
+          btn.addEventListener('click', () => updateStatus(btn.dataset.id, 'Perdido'));
+        });
+
+        document.querySelectorAll('.btn-confirmar-venta').forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const idx = btn.dataset.idx;
+            const producto = document.getElementById(`producto-${idx}`).value;
+            const monto = document.getElementById(`monto-${idx}`).value;
+            updateStatus(btn.dataset.id, 'Vendido', producto, monto);
+          });
+        });
+      }
+
+      async function updateStatus(id, estado, productoVendido = '', montoVenta = '') {
+        try {
+          await fetch(GOOGLE_SCRIPT_URL, {
+            method: 'POST',
+            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
+            body: JSON.stringify({
+              action: 'updateStatus',
+              token: getToken(),
+              id,
+              Estado: estado,
+              ProductoVendido: productoVendido,
+              MontoVenta: montoVenta,
+            }),
+          });
+          loadLeads();
+        } catch (err) {
+          alert('No se pudo actualizar. Revisa tu conexión.');
+        }
+      }
+
+      authBtn.addEventListener('click', () => {
+        sessionStorage.setItem('vg_admin_token', secretInput.value.trim());
+        authError.classList.add('hidden');
+        loadLeads();
+      });
+
+      secretInput.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter') authBtn.click();
+      });
+
+      refreshBtn?.addEventListener('click', loadLeads);
+
+      if (getToken()) loadLeads();
+    });
+  </script>
+</Layout>
