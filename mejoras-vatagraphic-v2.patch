+/**
+ * VataGraphic - Backend gratuito de Cartera de Clientes
+ * Convierte un Google Sheet en una base de datos simple para el formulario
+ * de cotizaciones y el panel /admin del sitio web.
+ *
+ * INSTRUCCIONES DE INSTALACIÓN:
+ * 1. Crea un Google Sheet nuevo y llámalo "VataGraphic - Cartera de Clientes".
+ * 2. En la primera hoja, cambia el nombre a "Leads" y pon estos encabezados
+ *    exactos en la fila 1 (columnas A a M):
+ *    ID | Fecha | Nombre | Empresa | Correo | Telefono | Rubro | ComoConocio |
+ *    ProductoInteres | Mensaje | Estado | ProductoVendido | MontoVenta | FechaCierre
+ * 3. Ve a Extensiones > Apps Script, borra el contenido y pega este archivo completo.
+ * 4. Cambia el valor de SECRET_TOKEN más abajo por una clave propia (cualquier texto).
+ * 5. Haz clic en "Implementar" > "Nueva implementación" > tipo "Aplicación web".
+ *    - Ejecutar como: Yo (tu cuenta)
+ *    - Quién tiene acceso: Cualquier usuario
+ * 6. Copia la URL que te entrega (termina en /exec) y pégala en src/constants.ts
+ *    como GOOGLE_SCRIPT_URL, y el mismo texto de SECRET_TOKEN como ADMIN_SECRET.
+ */
+
+const SHEET_NAME = "Leads";
+const SECRET_TOKEN = "cambia-esta-clave"; // TODO: reemplazar por una clave propia
+
+function doPost(e) {
+  const data = JSON.parse(e.postData.contents);
+  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
+
+  if (data.action === "updateStatus") {
+    return updateLeadStatus(sheet, data);
+  }
+
+  return createLead(sheet, data);
+}
+
+function doGet(e) {
+  if (e.parameter.token !== SECRET_TOKEN) {
+    return jsonResponse({ success: false, error: "No autorizado" });
+  }
+  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
+  const rows = sheet.getDataRange().getValues();
+  const headers = rows.shift();
+
+  const leads = rows.map((row) => {
+    const lead = {};
+    headers.forEach((header, i) => (lead[header] = row[i]));
+    return lead;
+  });
+
+  return jsonResponse({ success: true, leads: leads.reverse() });
+}
+
+function createLead(sheet, data) {
+  const id = Utilities.getUuid();
+  sheet.appendRow([
+    id,
+    new Date(),
+    data.Nombre || "",
+    data.Empresa || "",
+    data.Correo || "",
+    data.Telefono || "",
+    data.Rubro || "",
+    data.ComoConocio || "",
+    data.ProductoInteres || "",
+    data.Mensaje || "",
+    "Nuevo",
+    "",
+    "",
+    "",
+  ]);
+  return jsonResponse({ success: true, id: id });
+}
+
+function updateLeadStatus(sheet, data) {
+  if (data.token !== SECRET_TOKEN) {
+    return jsonResponse({ success: false, error: "No autorizado" });
+  }
+  const values = sheet.getDataRange().getValues();
+  const idColumn = 0; // Columna A = ID
+
+  for (let i = 1; i < values.length; i++) {
+    if (values[i][idColumn] === data.id) {
+      const rowNumber = i + 1;
+      sheet.getRange(rowNumber, 11).setValue(data.Estado || values[i][10]); // Estado
+      sheet.getRange(rowNumber, 12).setValue(data.ProductoVendido || "");
+      sheet.getRange(rowNumber, 13).setValue(data.MontoVenta || "");
+      sheet.getRange(rowNumber, 14).setValue(data.Estado === "Vendido" ? new Date() : "");
+      return jsonResponse({ success: true });
+    }
+  }
+  return jsonResponse({ success: false, error: "Lead no encontrado" });
+}
+
+function jsonResponse(obj) {
+  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(
+    ContentService.MimeType.JSON
+  );
+}
