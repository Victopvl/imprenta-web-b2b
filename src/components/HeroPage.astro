---
// src/components/HeroPage.astro
import { DESIGN_SYSTEM } from '../constants.ts';

interface Props {
  tagline: string;
  title: string;
  description: string;
}

const { tagline, title, description } = Astro.props;
---

<section class={`${DESIGN_SYSTEM.colors.heroBg} text-white relative overflow-hidden border-b border-slate-900`}>
  <div class={`${DESIGN_SYSTEM.layouts.mainGrid} ${DESIGN_SYSTEM.layouts.sectionPadding} relative z-10`}>
    <div class="max-w-4xl">
      <span class={DESIGN_SYSTEM.typography.tagline}>
        {tagline}
      </span>
      <h1 class={DESIGN_SYSTEM.typography.h1}>
        {title}
      </h1>
      <p class={DESIGN_SYSTEM.typography.heroParagraph}>
        {description}
      </p>
      <slot />
    </div>
  </div>
  <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-20"></div>
</section>