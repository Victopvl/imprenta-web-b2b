---
// src/layouts/Layout.astro
import { CONTACT_INFO } from '../constants.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "VataGraphic" } = Astro.props;

// 1. Detectamos la ruta actual del navegador y creamos un normalizador robusto
const pathname = Astro.url.pathname;
const normalizePath = (p: string) => p.replace(/\/$/, "") || "/";

const navItems = [
  { name: "Inicio", href: "/" },
  { name: "Sobre nosotros", href: "/sobre-nosotros" },
  { name: "Catálogo", href: "/catalogo" },
  { name: "Cotizaciones", href: "/cotizaciones" },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | {CONTACT_INFO.companyName}</title>
    <style>
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }
    </style>
  </head>
  <body class="bg-[#F7FAFD] text-slate-800 min-h-screen flex flex-col antialiased">
    
    <header class="bg-[#00456F] border-b border-white/10 sticky top-0 z-50 shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <a href="/" class="flex items-center gap-3 group transition-transform duration-300 hover:scale-[1.02]">
          <div class="bg-[#009EE0] w-10 h-10 rounded-xl flex items-center justify-center font-black text-white shadow-md transition-transform group-hover:rotate-3">
            <span class="text-xl">I</span>
          </div>
          <span class="font-bold text-lg tracking-tight text-white group-hover:text-[#91DAEE] transition-colors">
            VataGraphic
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-2 text-sm font-semibold">
          {navItems.map((item) => {
            // Comparamos de forma segura quitando slashes sobrantes
            const isCurrentPage = normalizePath(pathname) === normalizePath(item.href);
            
            return (
              <a 
                href={item.href} 
                class:list={[
                  // Clases base para animación, zoom y transiciones estables
                  "px-4 py-2.5 rounded-xl text-sm font-semibold transition-all duration-300 transform hover:scale-105 active:scale-95",
                  {
                    // ESTILO SELECCIONADO (Oscuro corporativo premium con sombra interior)
                    "bg-[#002D4A] text-white shadow-inner border border-white/5 font-bold": isCurrentPage,
                    
                    // ESTILO NORMAL (Texto claro, cambia a blanco brillante y fondo sutil en hover)
                    "text-blue-100/80 hover:text-white hover:bg-white/5": !isCurrentPage
                  }
                ]}
              >
                {item.name}
              </a>
            );
          })}
        </nav>

        <a 
          href={CONTACT_INFO.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-[#009EE0] hover:bg-[#1CB1E1] text-white font-bold px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider transition-all shadow-md hover:scale-105 active:scale-95"
        >
          Hablar con un Ejecutivo
        </a>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-[#00456F] py-12 text-center text-sm border-t border-white/5 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-blue-200/50 font-light">
          &copy; {new Date().getFullYear()} {CONTACT_INFO.companyName}. Todos los derechos reservados.
        </p>
      </div>
    </footer>

  </body>
</html>