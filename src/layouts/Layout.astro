---
// src/layouts/Layout.astro
import { DESIGN_SYSTEM, CONTACT_INFO } from '../constants.ts';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Imprenta Corporativa Industrial B2B" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | {CONTACT_INFO.companyName}</title>
    <style>
      /* Corrección global preventiva de fuentes */
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }
    </style>
  </head>
  <body class={`${DESIGN_SYSTEM.colors.bgLight} text-slate-800 min-h-screen flex flex-col antialiased`}>
    
    <header class={`${DESIGN_SYSTEM.colors.navBg} border-b border-white/10 sticky top-0 z-50 shadow-md`}>
      <div class={`${DESIGN_SYSTEM.layouts.mainGrid} h-20 flex items-center justify-between`}>
        
        <a href="/" class="flex items-center gap-3 group">
          <div class={`${DESIGN_SYSTEM.colors.brandPrimary} w-10 h-10 rounded-xl flex items-center justify-center font-black text-white shadow-md shadow-blue-500/20`}>
            <span class="text-xl">I</span>
          </div>
          <span class="font-bold text-lg tracking-tight text-white group-hover:text-[#91DAEE] transition-colors">
            Imprenta Corporativa
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-blue-100/90">
          <a href="/" class="hover:text-white transition-colors">Inicio</a>
          <a href="/sobre-nosotros" class="hover:text-white transition-colors">Sobre nosotros</a>
          <a href="/catalogo" class="hover:text-white transition-colors">Catálogo</a>
          <a href="/cotizaciones" class="hover:text-white transition-colors">Cotizaciones</a>
        </nav>

        <a 
          href={CONTACT_INFO.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class={`${DESIGN_SYSTEM.colors.brandPrimary} ${DESIGN_SYSTEM.colors.brandHover} text-white font-bold px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider transition-all shadow-lg shadow-blue-500/10 active:scale-95`}
        >
          Hablar con un Ejecutivo
        </a>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class={`${DESIGN_SYSTEM.colors.footerBg} py-12 text-center text-sm border-t border-white/5`}>
      <div class={DESIGN_SYSTEM.layouts.mainGrid}>
        <p class="text-blue-200/50 font-light">
          &copy; {new Date().getFullYear()} {CONTACT_INFO.companyName}. Todos los derechos reservados. Paleta Blue Studio Oficial.
        </p>
      </div>
    </footer>

  </body>
</html>