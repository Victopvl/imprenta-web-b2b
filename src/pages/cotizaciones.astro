---
// src/pages/cotizaciones.astro
import Layout from '../layouts/Layout.astro';
import { CONTACT_INFO, WEB3FORMS_ACCESS_KEY } from '../constants.ts';

const emailDestino = CONTACT_INFO.email || 'mvallejos@vatagraphic.cl';
---

<Layout title="Solicitar Cotización Industrial" description="Solicita tu cotización de impresión corporativa: completa el formulario o contáctanos por WhatsApp, correo o teléfono. Respuesta inmediata.">
  
  <section class="bg-gradient-to-br from-[#00456F] via-[#005C94] to-[#009EE0] relative overflow-hidden py-20 text-center text-white">
    <div class="absolute inset-0 bg-[radial-gradient(#91DAEE_1px,transparent_1px)] [background-size:16px_16px] opacity-15"></div>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <span class="text-[#91DAEE] font-bold uppercase tracking-widest text-xs">Atención Comercial Inmediata</span>
      <h1 class="text-4xl md:text-5xl font-black mt-3 mb-6 tracking-tight">
        ¿Cómo solicitar una cotización?
      </h1>
      <p class="text-blue-50/90 font-light leading-relaxed text-base md:text-lg">
Para ofrecerte un presupuesto exacto y adaptado a tu empresa, resolvemos cada solicitud de forma personalizada a través de nuestros canales oficiales. Escoge la opción que te resulte más cómoda.      </p>
    </div>
  </section>

  <section class="py-16 bg-[#F7FAFD]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <div class="lg:col-span-7 bg-white border border-[#91DAEE]/20 rounded-2xl p-8 shadow-sm">
          <h2 class="text-[#00456F] font-black text-xl md:text-2xl mb-6 tracking-tight flex items-center gap-2">
            📋 Información recomendada para su pedido
          </h2>
          <p class="text-slate-600 text-sm mb-8 leading-relaxed">
Ten a la mano los siguientes datos al momento de contactar a nuestro equipo. Esto nos ayudará a darte una respuesta mucho más rápida y poner en marcha tu proyecto sin demoras.          </p>

          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="bg-[#F7FAFD] border border-[#91DAEE]/40 text-[#009EE0] font-mono font-bold w-8 h-8 rounded-lg flex items-center justify-center shrink-0">1</div>
              <div>
                <h3 class="font-bold text-[#00456F] text-sm mb-1">Producto y Volumen</h3>
                <p class="text-slate-600 text-xs leading-relaxed">Especifique el artículo requerido (ej: Carpetas corporativas) y la cantidad exacta. Recuerde revisar los mínimos de compra (MOQ) en nuestro catálogo.</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="bg-[#F7FAFD] border border-[#91DAEE]/40 text-[#009EE0] font-mono font-bold w-8 h-8 rounded-lg flex items-center justify-center shrink-0">2</div>
              <div>
                <h3 class="font-bold text-[#00456F] text-sm mb-1">Especificaciones Técnicas</h3>
                <p class="text-slate-600 text-xs leading-relaxed">Indique si requiere un sustrato específico (gramaje del papel, tipo de tela o vinilo) y los acabados de protección (polilaminado mate, lacado UV o troquelados).</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="bg-[#F7FAFD] border border-[#91DAEE]/40 text-[#009EE0] font-mono font-bold w-8 h-8 rounded-lg flex items-center justify-center shrink-0">3</div>
              <div>
                <h3 class="font-bold text-[#00456F] text-sm mb-1">Archivos de Diseño (Opcional)</h3>
                <p class="text-slate-600 text-xs leading-relaxed">Si dispone del diseño, es ideal contar con planos mecánicos o archivos vectoriales en alta fidelidad (PDF, AI o EPS) listos para prensa.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-4">
          <h2 class="text-[#00456F] font-black text-lg md:text-xl mb-2 tracking-tight px-2">
            🚀 Seleccione su canal de preferencia
          </h2>
          
          <a 
            href={CONTACT_INFO.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block bg-emerald-600 hover:bg-emerald-500 text-white p-5 rounded-2xl shadow-sm transition-all duration-300 transform hover:scale-[1.03] group active:scale-95 border border-emerald-700/10"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <span class="text-3xl">💬</span>
                <div>
                  <h3 class="font-bold text-base">WhatsApp Corporativo</h3>
                  <p class="text-emerald-100 text-xs font-light">Respuesta inmediata de un ejecutivo</p>
                </div>
              </div>
              <span class="text-xl opacity-0 group-hover:opacity-100 transition-opacity">➔</span>
            </div>
          </a>

          <div 
            id="email-card"
            data-email={emailDestino}
            class="block bg-white hover:bg-[#F7FAFD] text-[#00456F] p-5 rounded-2xl shadow-sm transition-all duration-300 transform hover:scale-[1.03] group active:scale-95 border border-[#91DAEE]/30 cursor-pointer relative"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <span class="text-3xl">✉️</span>
                <div>
                  <h3 class="font-bold text-base text-[#00456F] flex items-center gap-2">
                    Correo Electrónico
                    <span id="copy-toast" class="text-[10px] bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-md opacity-0 transition-opacity duration-300 font-bold uppercase tracking-wider">
                      ¡Copiado!
                    </span>
                  </h3>
                  <p class="text-slate-500 text-xs font-light">{emailDestino}</p>
                </div>
              </div>
              <span id="email-action-btn" class="text-xs bg-[#F7FAFD] group-hover:bg-[#009EE0] group-hover:text-white text-slate-500 border border-slate-200 group-hover:border-[#009EE0] font-bold px-3 py-2 rounded-xl transition-all">
                Enviar
              </span>
            </div>
          </div>

          <a 
            href={`tel:${CONTACT_INFO.phone || ''}`}
            class="block bg-white hover:bg-[#F7FAFD] text-[#00456F] p-5 rounded-2xl shadow-sm transition-all duration-300 transform hover:scale-[1.03] group active:scale-95 border border-[#91DAEE]/30"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <span class="text-3xl">📞</span>
                <div>
                  <h3 class="font-bold text-base text-[#00456F]">Central Telefónica</h3>
                  <p class="text-slate-500 text-xs font-light">Atención directa para consultas urgentes</p>
                </div>
              </div>
              <span class="text-xl text-[#009EE0] opacity-0 group-hover:opacity-100 transition-opacity">➔</span>
            </div>
          </a>

        </div>

      </div>

      <div class="mt-12 bg-white border border-[#91DAEE]/20 rounded-2xl p-8 shadow-sm max-w-3xl mx-auto">
        <h2 class="text-[#00456F] font-black text-xl md:text-2xl mb-2 tracking-tight flex items-center gap-2">
          ✍️ O completa el formulario directo
        </h2>
        <p class="text-slate-600 text-sm mb-8 leading-relaxed">
          Envíanos tu solicitud y un ejecutivo te responderá a la brevedad.
        </p>

        <form id="quote-form" class="space-y-5">
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="hidden" name="subject" value="Nueva solicitud de cotización desde el sitio web" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="nombre" class="block text-xs font-bold text-[#00456F] mb-1.5 uppercase tracking-wider">Nombre completo *</label>
              <input type="text" id="nombre" name="Nombre" required class="w-full bg-[#F7FAFD] border border-slate-300 rounded-xl px-4 py-3 text-sm text-[#00456F] outline-none focus:border-[#009EE0] focus:ring-2 focus:ring-[#009EE0]/20 transition-all" />
            </div>
            <div>
              <label for="empresa" class="block text-xs font-bold text-[#00456F] mb-1.5 uppercase tracking-wider">Empresa</label>
              <input type="text" id="empresa" name="Empresa" class="w-full bg-[#F7FAFD] border border-slate-300 rounded-xl px-4 py-3 text-sm text-[#00456F] outline-none focus:border-[#009EE0] focus:ring-2 focus:ring-[#009EE0]/20 transition-all" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-xs font-bold text-[#00456F] mb-1.5 uppercase tracking-wider">Correo electrónico *</label>
              <input type="email" id="email" name="Correo" required class="w-full bg-[#F7FAFD] border border-slate-300 rounded-xl px-4 py-3 text-sm text-[#00456F] outline-none focus:border-[#009EE0] focus:ring-2 focus:ring-[#009EE0]/20 transition-all" />
            </div>
            <div>
              <label for="telefono" class="block text-xs font-bold text-[#00456F] mb-1.5 uppercase tracking-wider">Teléfono</label>
              <input type="tel" id="telefono" name="Teléfono" class="w-full bg-[#F7FAFD] border border-slate-300 rounded-xl px-4 py-3 text-sm text-[#00456F] outline-none focus:border-[#009EE0] focus:ring-2 focus:ring-[#009EE0]/20 transition-all" />
            </div>
          </div>

          <div>
            <label for="mensaje" class="block text-xs font-bold text-[#00456F] mb-1.5 uppercase tracking-wider">Detalle de tu pedido *</label>
            <textarea id="mensaje" name="Mensaje" required rows="4" placeholder="Producto, cantidad, especificaciones..." class="w-full bg-[#F7FAFD] border border-slate-300 rounded-xl px-4 py-3 text-sm text-[#00456F] outline-none focus:border-[#009EE0] focus:ring-2 focus:ring-[#009EE0]/20 transition-all resize-none"></textarea>
          </div>

          <button type="submit" id="submit-btn" class="w-full bg-[#009EE0] hover:bg-[#1CB1E1] text-white font-bold py-4 rounded-xl text-sm uppercase tracking-wider transition-all shadow-md active:scale-95">
            Enviar solicitud
          </button>

          <p id="form-result" class="text-center text-sm font-semibold hidden"></p>
        </form>
      </div>

    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const quoteForm = document.getElementById('quote-form');
      const submitBtn = document.getElementById('submit-btn');
      const formResult = document.getElementById('form-result');

      if (quoteForm) {
        quoteForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          submitBtn.disabled = true;
          submitBtn.innerText = 'Enviando...';
          formResult.classList.add('hidden');

          const formData = new FormData(quoteForm);
          const object = Object.fromEntries(formData);
          const json = JSON.stringify(object);

          try {
            const response = await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: json,
            });
            const result = await response.json();

            formResult.classList.remove('hidden');
            if (result.success) {
              formResult.textContent = '¡Gracias! Recibimos tu solicitud, te contactaremos pronto.';
              formResult.classList.remove('text-red-600');
              formResult.classList.add('text-emerald-600');
              quoteForm.reset();
            } else {
              formResult.textContent = 'Hubo un problema al enviar. Intenta por WhatsApp mientras lo revisamos.';
              formResult.classList.remove('text-emerald-600');
              formResult.classList.add('text-red-600');
            }
          } catch (error) {
            formResult.classList.remove('hidden');
            formResult.textContent = 'Hubo un problema al enviar. Intenta por WhatsApp mientras lo revisamos.';
            formResult.classList.add('text-red-600');
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerText = 'Enviar solicitud';
          }
        });
      }

      const emailCard = document.getElementById('email-card');
      const copyToast = document.getElementById('copy-toast');
      const actionBtn = document.getElementById('email-action-btn');

      if (emailCard) {
        emailCard.addEventListener('click', () => {
          const email = emailCard.getAttribute('data-email');
          
          // 1. Intentamos disparar la acción nativa de redactar correo
          window.location.href = `mailto:${email}?subject=Solicitud%20de%20Cotizacion%20Corporativa`;
          
          // 2. Fallback de respaldo: Lo copiamos inmediatamente al portapapeles del usuario
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(email).then(() => {
              // Mostramos el tag verde de éxito
              copyToast.classList.remove('opacity-0');
              copyToast.classList.add('opacity-100');
              actionBtn.innerText = "¡Copiado!";
              actionBtn.classList.remove('bg-[#F7FAFD]', 'text-slate-500');
              actionBtn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
              
              // Restauramos el botón después de 2.5 segundos
              setTimeout(() => {
                copyToast.classList.remove('opacity-100');
                copyToast.classList.add('opacity-0');
                actionBtn.innerText = "Enviar";
                actionBtn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
                actionBtn.classList.add('bg-[#F7FAFD]', 'text-slate-500');
              }, 2500);
            }).catch(err => console.error("Error al copiar: ", err));
          }
        });
      }
    });
  </script>

</Layout>