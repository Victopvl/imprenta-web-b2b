---
// src/pages/catalogo.astro
import Layout from '../layouts/Layout.astro';
import HeroPage from '../components/HeroPage.astro';
import { DESIGN_SYSTEM } from '../constants.ts';
import { catalogData } from '../data/productos.ts';
---

<Layout title="Catálogo Blue Studio" description="...">
  <HeroPage 
    tagline="Suministro Industrial B2B"
    title="Catálogo Técnico de Productos"
    description="Explore nuestra matriz de insumos con la nueva línea de acabados Blue Studio. Calidad garantizada en cada pliego."
  />

  <section class="py-12 md:py-20">
    <div class={DESIGN_SYSTEM.layouts.mainGrid}>
      
      <div class="bg-white border border-[#91DAEE]/50 rounded-2xl p-6 mb-16 shadow-lg shadow-blue-900/5 -translate-y-16 relative z-20">
        <div class="flex flex-col lg:flex-row gap-5 items-center">
          <div class="w-full lg:max-w-md relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-[#91DAEE]">🔍</span>
            <input 
              type="text" 
              id="search-input" 
              placeholder="Buscar insumo técnico..." 
              class="w-full bg-[#F7FAFD] border border-[#91DAEE]/40 rounded-xl pl-10 pr-4 py-3 text-sm text-[#00456F] outline-none focus:border-[#009EE0] transition-all"
            />
          </div>
          <div class="flex flex-wrap gap-2" id="category-filters">
             <button data-target="all" class="category-btn text-[11px] font-bold uppercase px-4 py-2.5 rounded-lg bg-[#009EE0] text-white transition-all shadow-sm">Todos</button>
             {catalogData.map((cat) => (
               <button data-target={cat.id} class="category-btn text-[11px] font-bold uppercase px-4 py-2.5 rounded-lg bg-[#E2E8F0] text-[#00456F] hover:bg-[#91DAEE]/30 transition-all">{cat.titulo}</button>
             ))}
          </div>
        </div>
      </div>

      <div class="space-y-20">
        {catalogData.map((category) => (
          <div class="category-section" data-category={category.id}>
            <div class="flex items-center gap-3 mb-8 border-b border-[#91DAEE]/30 pb-4">
              <div class="w-2 h-8 bg-[#009EE0] rounded-full"></div>
              <h2 class="text-2xl font-bold text-[#00456F]">{category.titulo}</h2>
            </div>

            <div class="bg-white rounded-2xl border border-[#91DAEE]/20 shadow-sm overflow-hidden">
              <table class="w-full text-left text-sm">
                <thead class="bg-[#F7FAFD] text-[#009EE0] font-bold uppercase text-[10px] tracking-widest border-b border-[#91DAEE]/20">
                  <tr>
                    <th class="px-8 py-5">Solución</th>
                    <th class="px-8 py-5">Material</th>
                    <th class="px-8 py-5 text-right">MOQ</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#91DAEE]/10">
                  {category.productos.map((p) => (
                    <tr class="product-row hover:bg-[#F7FAFD] transition-colors">
                      <td class="px-8 py-5 font-bold text-[#00456F]">{p.nombre}</td>
                      <td class="px-8 py-5 text-slate-500 font-light">{p.sustrato}</td>
                      <td class="px-8 py-5 text-right font-mono font-bold text-[#009EE0]">{p.moq}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>