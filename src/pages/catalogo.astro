---
// src/pages/catalogo.astro
import Layout from '../layouts/Layout.astro';
// IMPORTAMOS LOS DATOS DESDE TU ARCHIVO AMIGABLE:
import { catalogData } from '../data/productos';
---

<Layout title="Catálogo Técnico de Productos">
  
  <section class="bg-gradient-to-br from-[#009EE0] via-[#007BB3] to-[#00456F] relative overflow-hidden py-24 md:py-32 text-center">
    <div class="absolute inset-0 bg-[radial-gradient(#91DAEE_1px,transparent_1px)] [background-size:16px_16px] opacity-15"></div>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <span class="text-[#91DAEE] font-bold uppercase tracking-widest text-xs">Suministro y Abastecimiento B2B</span>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white mt-3 mb-6 tracking-tight">
        Catálogo Técnico de Productos
      </h1>
      <p class="text-blue-50/90 font-light leading-relaxed text-base md:text-lg">
        Consulte especificaciones de materiales, acabados de protección y volúmenes mínimos (MOQ) de nuestra planta de producción gráfica.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-[#F7FAFD]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white border border-[#91DAEE]/40 rounded-2xl p-6 mb-16 shadow-xl shadow-blue-900/5 -translate-y-12 relative z-20">
        <div class="flex flex-col lg:flex-row gap-5 items-center justify-between">
          <div class="w-full lg:max-w-md relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">🔍</span>
            <input 
              type="text" 
              id="search-input" 
              placeholder="Buscar por palabra clave (ej: carpeta, lapiz, banner)..." 
              class="w-full bg-white border border-slate-300 rounded-xl pl-10 pr-4 py-3.5 text-sm text-[#00456F] font-medium placeholder-slate-400 outline-none focus:border-[#009EE0] focus:ring-2 focus:ring-[#009EE0]/20 transition-all shadow-sm"
            />
          </div>
          
          <div class="flex flex-wrap gap-2 w-full lg:w-auto" id="category-filters">
             <button data-target="all" class="category-btn text-[11px] font-bold uppercase tracking-wider px-5 py-3 rounded-xl bg-[#009EE0] text-white transition-all shadow-md">
               Todos los productos
             </button>
             {catalogData.map((cat) => (
               <button data-target={cat.id} class="category-btn text-[11px] font-bold uppercase tracking-wider px-5 py-3 rounded-xl bg-[#E2E8F0] text-[#00456F] hover:bg-[#91DAEE]/30 transition-all font-semibold">
                 {cat.titulo}
               </button>
             ))}
          </div>
        </div>
      </div>

      <div class="space-y-24" id="catalog-sections-container">
        {catalogData.map((category) => (
          <div class="category-section transition-all duration-300" data-category={category.id}>
            
            <div class="mb-8">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-3 h-7 bg-[#009EE0] rounded-md"></div>
                <h2 class="text-[#00456F] font-black tracking-tight text-2xl md:text-3xl">{category.titulo}</h2>
              </div>
              <p class="text-slate-600 font-normal leading-relaxed text-sm">{category.descripcion}</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
              {category.productos.map((p) => (
                <div class="product-card bg-white rounded-2xl border border-[#91DAEE]/20 shadow-sm overflow-hidden flex flex-col hover:shadow-md transition-all duration-300 group">
                  
                  <div class="aspect-video w-full bg-slate-100 overflow-hidden relative border-b border-slate-100">
                    <img 
                      src={p.imagen} 
                      alt={p.nombre}
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>

                  <div class="p-6 flex flex-col flex-grow justify-between gap-5">
                    <div>
                      <h3 class="font-bold text-[#00456F] text-lg lg:text-xl mb-3 tracking-tight group-hover:text-[#009EE0] transition-colors">
                        {p.nombre}
                      </h3>
                      
                      <div class="space-y-2 text-xs text-slate-600 leading-relaxed">
                        <p>
                          <strong class="text-slate-800 font-semibold block">Sustrato base:</strong>
                          <span class="text-slate-600">{p.sustrato}</span>
                        </p>
                        <p>
                          <strong class="text-slate-800 font-semibold block">Acabado / Protección:</strong>
                          <span class="text-slate-600">{p.acabado}</span>
                        </p>
                      </div>

                      <span class="hidden">{p.tags.join(' ')}</span>
                    </div>

                    <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                      <span class="text-slate-400 font-medium">Volumen Mínimo (MOQ)</span>
                      <span class="font-mono font-bold bg-[#F7FAFD] text-[#009EE0] border border-[#91DAEE]/40 px-3 py-1 rounded-lg">
                        {p.moq}
                      </span>
                    </div>
                  </div>

                </div>
              ))}
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('search-input');
      const filterButtons = document.querySelectorAll('.category-btn');
      const sections = document.querySelectorAll('.category-section');
      let currentCategory = 'all';

      function filterCatalog() {
        const query = searchInput.value.toLowerCase().trim();

        sections.forEach(section => {
          const catId = section.getAttribute('data-category');
          const matchesCategory = (currentCategory === 'all' || catId === currentCategory);
          
          const cards = section.querySelectorAll('.product-card');
          let visibleCardsInSection = 0;

          cards.forEach(card => {
            // textContent lee tanto lo visible como el span oculto de nuestros tags
            const text = card.textContent.toLowerCase();
            if (text.includes(query)) {
              card.style.display = '';
              visibleCardsInSection++;
            } else {
              card.style.display = 'none';
            }
          });

          if (matchesCategory && visibleCardsInSection > 0) {
            section.style.display = '';
          } else {
            section.style.display = 'none';
          }
        });
      }

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          filterButtons.forEach(b => {
            b.classList.remove('bg-[#009EE0]', 'text-white', 'shadow-md');
            b.classList.add('bg-[#E2E8F0]', 'text-[#00456F]');
          });

          btn.classList.remove('bg-[#E2E8F0]', 'text-[#00456F]');
          btn.classList.add('bg-[#009EE0]', 'text-white', 'shadow-md');

          currentCategory = btn.getAttribute('data-target');
          filterCatalog();
        });
      });

      searchInput.addEventListener('input', filterCatalog);
    });
  </script>
</Layout>