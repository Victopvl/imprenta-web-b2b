---
// src/pages/catalogo.astro
import Layout from '../layouts/Layout.astro';
import HeroPage from '../components/HeroPage.astro';
import { DESIGN_SYSTEM, CONTACT_INFO } from '../constants.ts';
import { catalogData } from '../data/productos.ts';

const title = "Catálogo Técnico Avanzado - Imprenta Industrial";
const description = "Buscador y fichas técnicas de copiado, impresión masiva, regalos corporativos y gran formato.";
---

<Layout title={title} description={description}>

  <HeroPage 
    tagline="Suministro y Abastecimiento B2B"
    title="Catálogo Técnico de Productos"
    description="Consulte especificaciones de materiales, acabados de protección y volúmenes mínimos (MOQ) de nuestra planta de producción gráfica."
  />

  <section class={`${DESIGN_SYSTEM.colors.contentBg} pb-24 border-t border-slate-900`}>
    <div class={DESIGN_SYSTEM.layouts.mainGrid}>
      
      <div class="-translate-y-8 bg-slate-900 border border-slate-800 rounded-xl p-5 md:p-6 shadow-2xl backdrop-blur-md mb-12">
        <div class="flex flex-col lg:flex-row gap-5 items-stretch lg:items-center justify-between">
          
          <div class="w-full lg:max-w-md relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
              <svg class="h-4 w-4 text-slate-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input 
              type="text" 
              id="search-input" 
              placeholder="Buscar por insumo o palabra clave..." 
              class="w-full bg-slate-950 border border-slate-800 rounded-lg pl-10 pr-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#00D4B2] focus:ring-1 focus:ring-[#00D4B2] transition-all shadow-inner"
            />
          </div>

          <div class="flex flex-wrap gap-2 items-center" id="category-filters">
            <button 
              data-target="all" 
              class="category-btn text-[11px] font-bold uppercase tracking-wider px-4 py-2.5 rounded-lg border border-transparent bg-[#00D4B2] text-slate-950 transition-all shadow-sm"
            >
              Todos los productos
            </button>
            {catalogData.map((category) => (
              <button 
                data-target={category.id} 
                class="category-btn text-[11px] font-bold uppercase tracking-wider px-4 py-2.5 rounded-lg border border-slate-800 bg-slate-950 text-slate-300 hover:text-white hover:bg-slate-800 transition-all"
              >
                {category.titulo}
              </button>
            ))}
          </div>

        </div>
      </div>

      <div id="no-results" class="text-center py-16 bg-slate-900/20 rounded-xl border border-dashed border-slate-800 hidden mb-12">
        <p class="text-slate-300 text-base font-medium mb-1">No se encontraron coincidencias técnicas</p>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">Pruebe con términos generales o seleccione otra categoría del menú.</p>
      </div>

      <div class="space-y-20" id="catalog-container">
        {catalogData.map((category) => (
          <div class="category-section" data-category={category.id}>
            
            <div class="border-b border-slate-800 pb-4 mb-6">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-1.5 h-5 bg-[#00D4B2] rounded-sm"></div>
                <h2 class="text-xl font-bold text-white tracking-tight">{category.titulo}</h2>
              </div>
              <p class="text-slate-400 text-sm font-light max-w-4xl">{category.descripcion}</p>
            </div>

            <div class="overflow-x-auto rounded-xl border border-slate-800/90 bg-slate-900/30">
              <table class="w-full text-left border-collapse text-xs md:text-sm">
                <thead>
                  <tr class="bg-slate-900/80 text-slate-300 font-semibold border-b border-slate-800">
                    <th class="px-6 py-4 tracking-wide text-xs uppercase text-slate-400">Ítem / Solución</th>
                    <th class="px-6 py-4 tracking-wide text-xs uppercase text-slate-400">Material / Sustrato Base</th>
                    <th class="px-6 py-4 tracking-wide text-xs uppercase text-slate-400">Proceso e Impresión</th>
                    <th class="px-6 py-4 tracking-wide text-xs uppercase text-slate-400 text-right">Mínimo Comercial (MOQ)</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/40 text-slate-300">
                  {category.productos.map((product) => (
                    <tr 
                      class="product-row hover:bg-slate-900/40 transition-colors"
                      data-name={product.nombre.toLowerCase()}
                      data-tags={product.tags.join(' ')}
                    >
                      <td class="px-6 py-4 font-bold text-white whitespace-nowrap">{product.nombre}</td>
                      <td class="px-6 py-4 text-slate-300 font-light max-w-xs">{product.sustrato}</td>
                      <td class="px-6 py-4 text-slate-400 font-light max-w-sm">{product.acabado}</td>
                      <td class="px-6 py-4 text-right whitespace-nowrap">
                        <span class="inline-block bg-[#00D4B2]/10 text-[#00D4B2] border border-[#00D4B2]/20 px-2.5 py-1 rounded font-mono text-xs font-bold">
                          {product.moq}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <section class="bg-slate-950 py-16 border-t border-slate-900 text-center">
    <div class="max-w-4xl mx-auto px-4">
      <h3 class="text-xl font-bold text-white mb-2">¿Su requerimiento exige normas de color específicas?</h3>
      <p class="text-slate-400 text-xs mb-6 max-w-xl mx-auto leading-relaxed font-light">
        Trabajamos bajo estándares densitométricos estrictos para asegurar consistencia de marca en todas sus sucursales.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <a 
          href="/cotizaciones" 
          class="bg-[#00D4B2] hover:bg-[#00bda0] text-slate-950 font-bold px-6 py-3 rounded-lg text-xs uppercase tracking-wider transition-all duration-200"
        >
          Solicitar Cotización Formal
        </a>
        <a 
          href={CONTACT_INFO.whatsappUrl} 
          target="_blank"
          rel="noopener noreferrer"
          class="border border-slate-800 bg-slate-900 hover:bg-slate-800 text-white font-medium px-6 py-3 rounded-lg text-xs uppercase tracking-wider transition-colors"
        >
          Asesoría Técnica Inmediata
        </a>
      </div>
    </div>
  </section>

  <script>
    function initCatalogFilters() {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const categoryButtons = document.querySelectorAll('.category-btn');
      const categorySections = document.querySelectorAll('.category-section');
      const noResults = document.getElementById('no-results');

      if (!searchInput) return;

      let currentCategory = 'all';
      let searchQuery = '';

      function execFilter() {
        let itemsVisibleGlobal = 0;

        categorySections.forEach(section => {
          const sectionCategory = section.getAttribute('data-category');
          const rowsInSection = section.querySelectorAll('.product-row');
          let visibleRowsInSection = 0;

          const categoryMatches = currentCategory === 'all' || currentCategory === sectionCategory;

          rowsInSection.forEach(row => {
            const name = row.getAttribute('data-name') || '';
            const tags = row.getAttribute('data-tags') || '';
            const textMatches = name.includes(searchQuery) || tags.includes(searchQuery);

            if (categoryMatches && textMatches) {
              (row as HTMLElement).style.display = ''; 
              visibleRowsInSection++;
              itemsVisibleGlobal++;
            } else {
              (row as HTMLElement).style.display = 'none';
            }
          });

          if (visibleRowsInSection > 0) {
            (section as HTMLElement).style.display = '';
          } else {
            (section as HTMLElement).style.display = 'none';
          }
        });

        if (itemsVisibleGlobal === 0 && noResults) {
          noResults.classList.remove('hidden');
        } else if (noResults) {
          noResults.classList.add('hidden');
        }
      }

      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        execFilter();
      });

      categoryButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          categoryButtons.forEach(b => {
            b.classList.remove('bg-[#00D4B2]', 'text-slate-950');
            b.classList.add('bg-slate-950', 'text-slate-300', 'border-slate-800');
          });

          btn.classList.remove('bg-slate-950', 'text-slate-300', 'border-slate-800');
          btn.classList.add('bg-[#00D4B2]', 'text-slate-950');

          currentCategory = btn.getAttribute('data-target') || 'all';
          execFilter();
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initCatalogFilters);
    initCatalogFilters();
  </script>

</Layout>