---
// src/pages/sobre-nosotros.astro
import Layout from '../layouts/Layout.astro';
import HeroPage from '../components/HeroPage.astro';
import { DESIGN_SYSTEM } from '../constants.ts';

const title = "Sobre Nosotros - Infraestructura Industrial y Capacidad";
const description = "Conoce nuestra planta de producción gráfica automatizada.";
---

<Layout title={title} description={description}>

  <HeroPage 
    tagline="Socio de Suministro Gráfico B2B"
    title="Infraestructura instalada para responder bajo alta demanda volumétrica."
    description="No operamos como una imprenta rápida tradicional. Nos estructuramos para resolver las cadenas de abastecimiento gráfico de grandes compañías con cero margen de error."
  />

  <section class={`${DESIGN_SYSTEM.colors.contentBg} text-slate-300 border-t border-slate-900`}>
    <div class={`${DESIGN_SYSTEM.layouts.mainGrid} ${DESIGN_SYSTEM.layouts.sectionPadding}`}>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div>
          <h2 class="text-3xl font-black tracking-tight text-white mb-6">
            Procesos automatizados desde la orden hasta el despacho
          </h2>
          <p class="text-base leading-relaxed mb-6 font-light text-slate-300">
            Cada proceso está respaldado por maquinaria industrial de última generación y flujos optimizados bajo normas internacionales de calidad.
          </p>
          <div class="grid grid-cols-2 gap-6 border-t border-slate-800 pt-8">
            <div>
              <span class="block text-3xl font-black text-white tracking-tight mb-1">100%</span>
              <span class="text-xs uppercase tracking-wider font-bold text-slate-500 block">Fidelidad Pantone</span>
            </div>
            <div>
              <span class={`block text-3xl font-black ${DESIGN_SYSTEM.colors.accentText} tracking-tight mb-1`}>24/7</span>
              <span class="text-xs uppercase tracking-wider font-bold text-slate-500 block">Monitoreo de Pedidos</span>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          {[
            { id: "01", t: "Tecnología de Prensa Automatizada", d: "Prensas capaces de procesar miles de impresiones por hora con secado inmediato." },
            { id: "02", t: "Estandarización y Gestión del Color", d: "Calibración densitométrica rigurosa en cualquier soporte o sustrato." },
            { id: "03", t: "Logística Corporativa Integrada", d: "Despachamos de forma consolidada directamente en tus bodegas o locaciones." }
          ].map(item => (
            <div class="bg-slate-900/40 p-6 rounded-xl border border-slate-800/40">
              <div class="flex items-start gap-4">
                <div class={`w-8 h-8 rounded-md bg-[#00D4B2]/10 flex items-center justify-center ${DESIGN_SYSTEM.colors.accentText} font-bold shrink-0`}>{item.id}</div>
                <div>
                  <h3 class="text-lg font-bold text-white mb-2">{item.t}</h3>
                  <p class="text-slate-400 text-sm leading-relaxed font-light">{item.d}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

</Layout>