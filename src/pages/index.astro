---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { CONTACT_INFO, DESIGN_SYSTEM } from '../constants.ts';

// SEO Técnico: Títulos directos y descripciones bajo el límite de 155 caracteres
const title = "Soluciones Gráficas e Impresión Corporativa";
const description = "Imprenta industrial B2B. Proveedor oficial para empresas, hoteles, colegios y eventos. Impresión offset, digital y gran formato con entrega estricta.";

// Data de servicios destacados para empresas grandes
const featuredServices = [
  {
    title: "Papelería Corporativa e Institucional",
    desc: "Suministro continuo de carpetas corporativas, hojas membretadas, sobres y tarjetería fina para hoteles, colegios y marcas ejecutivas.",
    specs: ["Papeles certificados", "Acabados sectorizados", "Control estricto de color (Pantone)"]
  },
  {
    title: "Gran Formato y Producción para Eventos",
    desc: "Pendones rollers, lienzos de alta densidad, gráficas vehiculares y muros fotográficos para productoras, ferias y empresas de publicidad.",
    specs: ["Plotter alta resolución", "Sustratos intemperie", "Soporte de montaje reforzado"]
  },
  {
    title: "Merchandising y Material Promocional",
    desc: "Producción a escala de artículos corporativos de alta gama, libretas personalizadas, bolígrafos y regalos institucionales.",
    specs: ["Grabado láser y tampografía", "Catálogo premium", "Descuentos por volumen B2B"]
  }
];
---

<Layout title={title} description={description}>
  
  <header class={`${DESIGN_SYSTEM.colors.primaryBg} border-b border-slate-800 text-white sticky top-0 z-50`}>
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" target="_self" class="text-xl font-bold tracking-tight text-white">
        {CONTACT_INFO.companyName}
      </a>
      <nav class="hidden md:flex items-center space-x-8 text-sm font-medium tracking-wide">
        <a href="/" target="_self" class="text-[#00D4B2] transition-colors">Inicio</a>
        <a href="/servicios" target="_self" class="text-slate-300 hover:text-white transition-colors">Servicios y Capacidad</a>
        <a href="/contacto" target="_self" class="text-slate-300 hover:text-white transition-colors">Contacto Directo</a>
      </nav>
      <div>
        <a 
          href={CONTACT_INFO.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class={`${DESIGN_SYSTEM.colors.accent} ${DESIGN_SYSTEM.colors.accentHover} text-slate-950 text-xs uppercase tracking-wider font-bold px-4 py-2.5 rounded-sm transition-colors`}
        >
          Hablar con un Ejecutivo
        </a>
      </div>
    </div>
  </header>

  <section class={`${DESIGN_SYSTEM.colors.primaryBg} text-white relative overflow-hidden`}>
    <div class={`${DESIGN_SYSTEM.layouts.sectionPadding} relative z-10 flex flex-col justify-center min-h-[70vh]`}>
      <div class="max-w-3xl">
        <span class="text-[#00D4B2] font-semibold tracking-widest text-xs uppercase block mb-3">Socio Gráfico Industrial B2B</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1] mb-6">
          Impresión de alta fidelidad y logística a gran escala para empresas.
        </h1>
        <p class="text-slate-300 text-lg md:text-xl font-light leading-relaxed mb-10 max-w-2xl">
          Especializados en resolver las necesidades gráficas de colegios, hoteles, productoras y corporativos con tiempos de entrega rigurosos y calidad garantizada.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a 
            href={CONTACT_INFO.whatsappUrl} 
            target="_blank"
            rel="noopener noreferrer"
            class={`${DESIGN_SYSTEM.colors.accent} ${DESIGN_SYSTEM.colors.accentHover} text-slate-950 font-bold px-8 py-4 text-center rounded-sm transition-colors shadow-lg shadow-[#00D4B2]/10`}
          >
            Iniciar Cotización Corporativa
          </a>
          <a 
            href="/servicios" 
            target="_self"
            class="border border-slate-700 bg-slate-900/40 hover:bg-slate-900 text-white font-medium px-8 py-4 text-center rounded-sm transition-colors"
          >
            Ver Capacidad Técnica
          </a>
        </div>
      </div>
    </div>
    
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-20"></div>
  </section>

  <section class={`${DESIGN_SYSTEM.colors.lightBg}`}>
    <div class={DESIGN_SYSTEM.layouts.sectionPadding}>
      <div class="mb-16">
        <h2 class={DESIGN_SYSTEM.layouts.title}>Líneas de Producción Principal</h2>
        <p class={DESIGN_SYSTEM.layouts.subtitle}>
          No hacemos trabajos minoristas simples. Nos enfocamos en proveer soluciones volumétricas completas bajo estándares corporativos.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {featuredServices.map((service) => (
          <div class={`${DESIGN_SYSTEM.colors.whiteCard} ${DESIGN_SYSTEM.layouts.cardBorder} p-8 flex flex-col justify-between`}>
            <div>
              <div class="w-12 h-1 bg-[#0A2540] mb-6"></div>
              <h3 class="text-xl font-bold text-slate-900 mb-3">{service.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">{service.desc}</p>
            </div>
            
            <div class="border-t border-slate-100 pt-5 mt-4">
              <span class="text-[11px] uppercase tracking-wider font-bold text-slate-400 block mb-3">Estándar Técnico:</span>
              <ul class="space-y-2">
                {service.specs.map((spec) => (
                  <li class="text-xs text-slate-600 flex items-center">
                    <span class="mr-2 text-[#00D4B2] font-bold">✓</span> {spec}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white border-t border-slate-100">
    <div class={DESIGN_SYSTEM.layouts.sectionPadding}>
      <div class="bg-[#0A2540] text-white p-8 md:p-16 rounded-sm flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="max-w-xl">
          <h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-3">¿Eres encargado de compras o productor?</h3>
          <p class="text-slate-300 text-sm md:text-base font-light leading-relaxed">
            Sabemos que tu prioridad es el cumplimiento de plazos y la fidelidad del color. Asignamos un ejecutivo técnico exclusivo para gestionar tus requerimientos desde la orden de compra hasta la entrega en tus instalaciones.
          </p>
        </div>
        <div class="w-full lg:w-auto shrink-0">
          <a 
            href={CONTACT_INFO.whatsappUrl} 
            target="_blank"
            rel="noopener noreferrer"
            class={`${DESIGN_SYSTEM.colors.accent} ${DESIGN_SYSTEM.colors.accentHover} text-slate-950 font-bold px-8 py-4 rounded-sm block text-center transition-colors`}
          >
            Contactar Ejecutivo Asignado
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>